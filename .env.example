# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# Deployment identity ---------------------------------------------------------
COMPOSE_PROJECT_NAME=multica-runtime
MULTICA_IMAGE=multica-runtime:local
MULTICA_DAEMON_DEVICE_NAME=my-server-01
MULTICA_AGENT_RUNTIME_NAME=Docker runtime

# Authentication --------------------------------------------------------------
# Cloud Node PAT (mcn_...) or user PAT (mul_...).
# Leave empty to run an interactive `multica login --token` inside the container.
MULTICA_TOKEN=

# Agent CLIs authenticate through their own subscription login, once, and the
# credentials persist in the home volume. Do NOT set ANTHROPIC_API_KEY or
# OPENAI_API_KEY here unless you deliberately want per-token API billing:
#   docker compose exec --user node multica-runtime claude auth login
#   docker compose exec --user node multica-runtime codex login

# Storage ---------------------------------------------------------------------
# Host root for persistent data. On a server with a dedicated disk:
#   MULTICA_DATA_ROOT=/mnt/data/multica
MULTICA_DATA_ROOT=./data

# Match the owner of the host directory (its `id -u` / `id -g`)
PUID=1000
PGID=1000
MULTICA_FIX_PERMISSIONS=shallow

# Daemon behaviour ------------------------------------------------------------
MULTICA_DAEMON_MAX_CONCURRENT_TASKS=6
MULTICA_DAEMON_AUTO_UPDATE=false
MULTICA_GC_ENABLED=true
MULTICA_GC_COMPLETED_TASK_TTL=24h
MULTICA_GC_ARTIFACT_TTL=6h
MULTICA_GC_REPO_TTL=168h

# Build -----------------------------------------------------------------------
# Pin a tag or a SHA for reproducible builds.
MULTICA_REF=main
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
CBM_VERSION=0.10.8
INSTALL_BROWSER_DEPS=false

# Agent plugins ---------------------------------------------------------------
# ponytail (MIT) is installed into ~/.claude and ~/.codex on container start.
# It tracks the upstream default branch: there is no version pin available.
PONYTAIL_ENABLED=true
PONYTAIL_REPO=DietrichGebert/ponytail

# Misc ------------------------------------------------------------------------
GIT_USER_NAME=
GIT_USER_EMAIL=
MULTICA_SHM_SIZE=1gb
MULTICA_STOP_GRACE_PERIOD=120s
CBM_LOG_LEVEL=info
