# ---------------------------------------------------------------------------
# Copier en .env puis adapter. Ne jamais commiter le .env rempli.
# ---------------------------------------------------------------------------

# Identite du deploiement -----------------------------------------------------
COMPOSE_PROJECT_NAME=multica-runtime
MULTICA_IMAGE=multica-runtime:local
MULTICA_DAEMON_DEVICE_NAME=my-server-01
MULTICA_AGENT_RUNTIME_NAME=Docker runtime

# Authentification ------------------------------------------------------------
# PAT Cloud Node (mcn_...) ou PAT utilisateur (mul_...).
# Laisser vide pour faire un `multica login --token` interactif dans le conteneur.
MULTICA_TOKEN=

# Cles agents (optionnelles selon les CLI utilisees)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CURSOR_API_KEY=

# Stockage --------------------------------------------------------------------
# Racine hote des donnees persistantes. Sur un serveur avec disque dedie :
#   MULTICA_DATA_ROOT=/mnt/data/multica
MULTICA_DATA_ROOT=./data

# Alignement des droits sur un bind mount hote (id -u / id -g du proprietaire)
PUID=1000
PGID=1000
MULTICA_FIX_PERMISSIONS=shallow

# Comportement du daemon ------------------------------------------------------
MULTICA_DAEMON_MAX_CONCURRENT_TASKS=6
MULTICA_DAEMON_AUTO_UPDATE=false
MULTICA_GC_ENABLED=true
MULTICA_GC_COMPLETED_TASK_TTL=24h
MULTICA_GC_ARTIFACT_TTL=6h
MULTICA_GC_REPO_TTL=168h

# Build -----------------------------------------------------------------------
# Epingler un tag ou un SHA pour un build reproductible.
MULTICA_REF=main
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
CBM_VERSION=0.10.8
INSTALL_BROWSER_DEPS=false

# Divers ----------------------------------------------------------------------
GIT_USER_NAME=
GIT_USER_EMAIL=
MULTICA_SHM_SIZE=1gb
MULTICA_STOP_GRACE_PERIOD=120s
CBM_LOG_LEVEL=info
